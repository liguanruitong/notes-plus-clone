{
  "name": "notes-plus-clone",
  "version": "1.8.1",
  "description": "手写笔记应用（Notes Plus 风格）：压感手写 / 荧光笔 / 竖向连续多页 / 导出 PDF",
  "main": "src/main/index.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "jspdf": "^2.5.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.notesplus.clone",
    "productName": "手写笔记",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon-256.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "NotesPlus-win-x64-${version}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "NotesPlus-portable-${version}.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
